+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Academic Studio: the coding agents the app can drive.
+//
+// Every agent-specific id, folder and file name comes from the
+// academicStudioAgents registry in product.json (overlay/product.overrides.json),
+// which the built-in extensions read too, so there is one source of truth. The
+// active agent is the academicStudio.agent setting, registered here; when it is
+// unset or names an agent this build does not know, academicStudioDefaultAgent
+// applies.
+//
+// `features` maps each menu capability to the implementation that serves it for
+// this agent (for Claude: 'claude-jsonl' conversations, 'claude-settings'
+// toggles, ...). A capability an agent lacks is simply absent, and the menu item
+// says so rather than reading another agent's files.
+
+import { localize } from '../../../../nls.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { Extensions as ConfigurationExtensions, IConfigurationRegistry } from '../../../../platform/configuration/common/configurationRegistry.js';
+import product from '../../../../platform/product/common/product.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+
+export const AGENT_SETTING = 'academicStudio.agent';
+
+export interface IAgentFeatures {
+	readonly conversations?: 'claude-jsonl';
+	readonly permissions?: 'claude-code';
+	readonly toggles?: 'claude-settings';
+	readonly connectors?: 'claude-json';
+	readonly plugins?: 'claude-marketplace';
+}
+
+export interface IAgentDefinition {
+	/** registry key, e.g. 'claude' */
+	readonly id: string;
+	/** shown in menus and messages, e.g. 'Claude' */
+	readonly displayName: string;
+	/** the VS Code extension that provides the chat */
+	readonly extensionId: string;
+	/** the extension's settings section, e.g. 'claudeCode' */
+	readonly settingsSection?: string;
+	readonly commands: {
+		/** opens the chat; may take a conversation id to resume */
+		readonly open: string;
+		readonly newChat?: string;
+	};
+	/** case-insensitive pattern that recognizes the chat's editor tab */
+	readonly tabPattern?: string;
+	/** user-level config folder, relative to the home directory, e.g. '.claude' */
+	readonly homeDir: string;
+	/** per-project config folder, relative to the workspace folder, e.g. '.claude' */
+	readonly projectDir: string;
+	/** instructions file name read from the project root and from homeDir, e.g. 'CLAUDE.md' */
+	readonly instructionsFile: string;
+	/**
+	 * How instructionsFile pulls in another file, with {0} for its name (Claude:
+	 * '@{0}'). When set and instructionsFile is not AGENTS.md, the menu offers a
+	 * shared AGENTS.md and adds the import line for it.
+	 */
+	readonly importSyntax?: string;
+	/** user-level config file relative to the home directory, e.g. '.claude.json' */
+	readonly userConfigFile?: string;
+	/** skills folder name inside homeDir and projectDir */
+	readonly skillsDir: string;
+	readonly urls: {
+		readonly skills?: string;
+		readonly mcpDocs?: string;
+		readonly plugins?: string;
+		readonly communityPlugins?: string;
+	};
+	readonly features: IAgentFeatures;
+}
+
+type RawRegistry = Record<string, Omit<IAgentDefinition, 'id'> | string>;
+
+function rawRegistry(): RawRegistry {
+	const raw = (product as { academicStudioAgents?: RawRegistry }).academicStudioAgents;
+	return raw && typeof raw === 'object' ? raw : {};
+}
+
+/** Every agent in the registry; keys starting with '_' are comments. */
+export function allAgents(): IAgentDefinition[] {
+	const agents: IAgentDefinition[] = [];
+	for (const [id, value] of Object.entries(rawRegistry())) {
+		if (id.startsWith('_') || !value || typeof value !== 'object') {
+			continue;
+		}
+		agents.push({ ...value, id, urls: value.urls ?? {}, features: value.features ?? {} });
+	}
+	return agents;
+}
+
+function defaultAgentId(): string {
+	return (product as { academicStudioDefaultAgent?: string }).academicStudioDefaultAgent || 'claude';
+}
+
+/** The agent the menu acts on: the setting's choice, else the product default, else the first registered one. */
+export function activeAgent(configurationService: IConfigurationService): IAgentDefinition | undefined {
+	const agents = allAgents();
+	const chosen = configurationService.getValue<string>(AGENT_SETTING);
+	return agents.find(agent => agent.id === chosen)
+		?? agents.find(agent => agent.id === defaultAgentId())
+		?? agents[0];
+}
+
+// The setting is registered only when the build knows at least one agent; its
+// allowed values are exactly the registry's keys.
+const knownAgents = allAgents();
+if (knownAgents.length) {
+	Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).registerConfiguration({
+		id: 'academicStudio',
+		title: localize('academicStudioConfigurationTitle', "Academic Studio"),
+		type: 'object',
+		properties: {
+			[AGENT_SETTING]: {
+				type: 'string',
+				enum: knownAgents.map(agent => agent.id),
+				enumItemLabels: knownAgents.map(agent => agent.displayName),
+				default: knownAgents.some(agent => agent.id === defaultAgentId()) ? defaultAgentId() : knownAgents[0].id,
+				description: localize('academicStudioAgentSetting', "The coding agent the agent menu, the startup chat tab, and Run Setup's plugin installs work with.")
+			}
+		}
+	});
+}
