@@ -0,0 +1,1277 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Academic Studio: handlers for the top-level Claude menu (the menu itself is
+// registered in vs/workbench/browser/parts/titlebar/menubar.contribution.ts).
+//
+// These used to live in the academic-studio-defaults built-in extension. They
+// cannot: an extension with a `main` and no `extensionKind` is deduced as
+// ['workspace'], and in a remote window a workspace extension that is not
+// installed on the remote runs nowhere at all -- so every menu item failed with
+// "command not found" over Remote-SSH. Core has no such placement problem, and
+// IPathService.userHome() resolves to the REMOTE home directory in a remote
+// window, which is the one that matters: Claude Code runs on the remote host,
+// so ~/.claude there is the config it actually reads.
+//
+// The menu acts on the ACTIVE AGENT (agents.ts): every folder, file name,
+// command id and URL below comes from its academicStudioAgents entry in
+// product.json. Code that understands one agent's own file formats -- Claude
+// Code's conversation logs, settings toggles, ~/.claude.json, plugin registry --
+// runs only when the agent declares that feature; otherwise the menu item says
+// the agent does not support it yet.
+
+import { VSBuffer } from '../../../../base/common/buffer.js';
+import { joinPath } from '../../../../base/common/resources.js';
+import { URI } from '../../../../base/common/uri.js';
+import { localize, localize2 } from '../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ConfigurationTarget, IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IDialogService } from '../../../../platform/dialogs/common/dialogs.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { INotificationService } from '../../../../platform/notification/common/notification.js';
+import { IOpenerService } from '../../../../platform/opener/common/opener.js';
+import { IQuickInputService, IQuickPickItem, QuickPickInput } from '../../../../platform/quickinput/common/quickInput.js';
+import { IWorkspaceFolder, IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+import { IPathService } from '../../../services/path/common/pathService.js';
+import { activeAgent, IAgentDefinition, IAgentFeatures } from './agents.js';
+
+// Static: the command palette category is registered before any agent is
+// chosen. The menu title in patch 54 is likewise fixed for now.
+const CLAUDE_CATEGORY = localize2('academicStudioClaudeCategory', "Claude");
+
+//#region helpers
+
+/**
+ * Every service these commands use, resolved in one synchronous pass.
+ *
+ * This is not a style preference: `ServicesAccessor.get` throws
+ * ("service accessor is only valid during the invocation of its target method")
+ * as soon as the action's `run` yields, and every command here is async. Grab
+ * the lot before the first await, then pass this around.
+ */
+interface IClaudeServices {
+	/** the agent this invocation acts on, fixed for the whole command */
+	readonly agent: IAgentDefinition;
+	readonly commandService: ICommandService;
+	readonly configurationService: IConfigurationService;
+	readonly dialogService: IDialogService;
+	readonly editorService: IEditorService;
+	readonly fileService: IFileService;
+	readonly notificationService: INotificationService;
+	readonly openerService: IOpenerService;
+	readonly pathService: IPathService;
+	readonly quickInputService: IQuickInputService;
+	readonly workspaceContextService: IWorkspaceContextService;
+}
+
+function claudeServices(accessor: ServicesAccessor): IClaudeServices | undefined {
+	const configurationService = accessor.get(IConfigurationService);
+	const agent = activeAgent(configurationService);
+	if (!agent) {
+		accessor.get(INotificationService).error(localize('academicStudioNoAgent', "No coding agent is configured in this build of Academic Studio."));
+		return undefined;
+	}
+	return {
+		agent,
+		commandService: accessor.get(ICommandService),
+		configurationService,
+		dialogService: accessor.get(IDialogService),
+		editorService: accessor.get(IEditorService),
+		fileService: accessor.get(IFileService),
+		notificationService: accessor.get(INotificationService),
+		openerService: accessor.get(IOpenerService),
+		pathService: accessor.get(IPathService),
+		quickInputService: accessor.get(IQuickInputService),
+		workspaceContextService: accessor.get(IWorkspaceContextService)
+	};
+}
+
+/**
+ * The agent's home folder (~/.claude for Claude) in the environment the agent
+ * actually runs in: the remote home over Remote-SSH, the local one otherwise.
+ */
+async function claudeHome(services: IClaudeServices): Promise<URI> {
+	return joinPath(await services.pathService.userHome(), services.agent.homeDir);
+}
+
+/** '~/<homeDir>/<rest>' for display in menu details. */
+function homeLabel(services: IClaudeServices, ...rest: string[]): string {
+	return ['~', services.agent.homeDir, ...rest].join('/');
+}
+
+/**
+ * True when the active agent provides `feature`. Otherwise tells the user the
+ * menu item is not available for this agent and returns false.
+ */
+function hasFeature(services: IClaudeServices, feature: keyof IAgentFeatures, what: string): boolean {
+	if (services.agent.features[feature]) {
+		return true;
+	}
+	services.notificationService.info(localize('academicStudioAgentNoFeature', "{0} is not available for {1} yet.", what, services.agent.displayName));
+	return false;
+}
+
+function firstFolder(services: IClaudeServices): IWorkspaceFolder | undefined {
+	return services.workspaceContextService.getWorkspace().folders[0];
+}
+
+/**
+ * The filesystem path a folder has on the machine Claude Code runs on. For a
+ * remote workspace that is the path on the host (URI.path); locally it is the
+ * platform path, which on Windows means backslashes.
+ */
+function agentPath(resource: URI): string {
+	return resource.scheme === 'file' ? resource.fsPath : resource.path;
+}
+
+async function readText(services: IClaudeServices, resource: URI, length?: number): Promise<string | undefined> {
+	try {
+		const content = await services.fileService.readFile(resource, length ? { length } : undefined);
+		return content.value.toString();
+	} catch (e) {
+		return undefined; // missing or unreadable
+	}
+}
+
+/** Create the file with `template` if it is not there yet, then open it. */
+async function ensureAndOpen(services: IClaudeServices, resource: URI, template: string): Promise<void> {
+	if (!(await services.fileService.exists(resource))) {
+		await services.fileService.writeFile(resource, VSBuffer.fromString(template));
+	}
+	await services.editorService.openEditor({ resource, options: { pinned: true } });
+}
+
+function openUrl(services: IClaudeServices, url: string): Promise<boolean> {
+	return services.openerService.open(URI.parse(url), { openExternal: true });
+}
+
+//#endregion
+
+//#region New Chat / Conversations
+
+class ClaudeNewChatAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudeNewChat',
+			title: localize2('academicStudioClaudeNewChat', "New Chat"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	// Deliberately passes NO arguments through: a menu-invoked command receives
+	// a { from: 'menu' } argument, which the Claude Code extension's own
+	// commands choke on ("e.replace is not a function").
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		if (!services) {
+			return;
+		}
+		const commandService = services.commandService;
+		const commands = services.agent.commands;
+		try {
+			if (!commands.newChat) {
+				throw new Error('no new-chat command');
+			}
+			await commandService.executeCommand(commands.newChat);
+		} catch (e) {
+			await commandService.executeCommand(commands.open);
+		}
+	}
+}
+
+interface IConversationItem extends IQuickPickItem {
+	sessionId: string;
+}
+
+/**
+ * Claude Code stores each conversation as
+ * ~/.claude/projects/<encoded-cwd>/<sessionId>.jsonl, where the folder name is
+ * the workspace path with every non-alphanumeric character turned into '-'.
+ */
+function claudeProjectsDirName(folder: IWorkspaceFolder): string {
+	return agentPath(folder.uri).replace(/[^a-zA-Z0-9]/g, '-');
+}
+
+/**
+ * Best-effort human title for a session: its first genuine user message,
+ * skipping slash-command and system-wrapper turns (which start with '<').
+ * Conversations run to tens of megabytes, so only the head is read.
+ */
+function sessionTitle(text: string): string {
+	for (const line of text.split('\n')) {
+		if (!line.trim()) {
+			continue;
+		}
+		let entry: any;
+		try {
+			entry = JSON.parse(line);
+		} catch (e) {
+			continue; // a truncated last line is expected
+		}
+		if (entry?.type === 'user' && entry.message) {
+			const content = entry.message.content;
+			let title = typeof content === 'string'
+				? content
+				: Array.isArray(content) ? content.filter((p: any) => p?.type === 'text').map((p: any) => p.text).join(' ') : '';
+			title = (title || '').replace(/\s+/g, ' ').trim();
+			if (title && title[0] !== '<') {
+				return title.length > 90 ? title.slice(0, 90) + '…' : title;
+			}
+		}
+	}
+	return '';
+}
+
+class ClaudeConversationsAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudeConversations',
+			title: localize2('academicStudioClaudeConversations', "Conversations…"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		if (!services) {
+			return;
+		}
+		if (!hasFeature(services, 'conversations', localize('academicStudioFeatureConversations', "Reopening previous conversations"))) {
+			return;
+		}
+		const notificationService = services.notificationService;
+		const folder = firstFolder(services);
+		if (!folder) {
+			notificationService.info(localize('academicStudioClaudeNoFolder', "Open a project folder first — conversations are listed per project."));
+			return;
+		}
+
+		const dir = joinPath(await claudeHome(services), 'projects', claudeProjectsDirName(folder));
+		let sessions: { id: string; resource: URI; mtime: number }[] = [];
+		try {
+			const stat = await services.fileService.resolve(dir, { resolveMetadata: true });
+			sessions = (stat.children ?? [])
+				.filter(child => !child.isDirectory && child.name.endsWith('.jsonl'))
+				.map(child => ({ id: child.name.slice(0, -6), resource: child.resource, mtime: child.mtime }));
+		} catch (e) {
+			// directory absent — no conversations yet
+		}
+
+		if (!sessions.length) {
+			notificationService.info(localize('academicStudioClaudeNoConversations', "No previous {0} conversations for this project yet.", services.agent.displayName));
+			return;
+		}
+
+		sessions.sort((a, b) => b.mtime - a.mtime);
+
+		const items: IConversationItem[] = [];
+		for (const session of sessions) {
+			const head = await readText(services, session.resource, 65536);
+			items.push({
+				label: (head ? sessionTitle(head) : '') || localize('academicStudioClaudeUntitled', "(untitled conversation)"),
+				description: new Date(session.mtime).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }),
+				sessionId: session.id
+			});
+		}
+
+		const picked = await services.quickInputService.pick(items, {
+			title: localize('academicStudioClaudeConversationsTitle', "{0} Conversations — {1}", services.agent.displayName, folder.name),
+			placeHolder: localize('academicStudioClaudeConversationsPlaceholder', "Select a previous conversation to reopen it in {0}", services.agent.displayName)
+		});
+		if (!picked) {
+			return;
+		}
+
+		// Same in-session resume that /resume performs: the extension's own
+		// vscode://anthropic.claude-code/open?session=… deep link calls exactly this.
+		try {
+			await services.commandService.executeCommand(services.agent.commands.open, picked.sessionId);
+		} catch (e) {
+			notificationService.error(localize('academicStudioClaudeResumeFailed', "Could not reopen the conversation: {0}", e instanceof Error ? e.message : String(e)));
+		}
+	}
+}
+
+//#endregion
+
+//#region Permissions
+
+// The Claude Code extension exposes claudeCode.initialPermissionMode with these
+// four values (its full allowed set). "bypassPermissions" is additionally gated
+// behind claudeCode.allowDangerouslySkipPermissions, set and cleared here so the
+// picked mode actually takes effect.
+interface IPermissionItem extends IQuickPickItem {
+	mode: string;
+}
+
+class ClaudePermissionsAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudePermissions',
+			title: localize2('academicStudioClaudePermissions', "Permissions…"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		if (!services) {
+			return;
+		}
+		if (!hasFeature(services, 'permissions', localize('academicStudioFeaturePermissions', "Choosing permissions from this menu"))) {
+			return;
+		}
+		const configurationService = services.configurationService;
+		const section = services.agent.settingsSection ?? 'claudeCode';
+		const current = configurationService.getValue<string>(`${section}.initialPermissionMode`) || 'default';
+
+		const modes: IPermissionItem[] = [
+			{
+				mode: 'default',
+				label: localize('academicStudioClaudePermAsk', "Ask before changes"),
+				detail: localize('academicStudioClaudePermAskDetail', "Claude asks your permission before editing files or running commands.")
+			},
+			{
+				mode: 'acceptEdits',
+				label: localize('academicStudioClaudePermEdits', "Allow file edits"),
+				detail: localize('academicStudioClaudePermEditsDetail', "Claude edits files without asking, but still asks before running commands.")
+			},
+			{
+				mode: 'plan',
+				label: localize('academicStudioClaudePermPlan', "Plan first"),
+				detail: localize('academicStudioClaudePermPlanDetail', "Claude only reads and proposes a plan; nothing changes until you approve it.")
+			},
+			{
+				mode: 'bypassPermissions',
+				label: localize('academicStudioClaudePermAll', "Allow everything"),
+				detail: localize('academicStudioClaudePermAllDetail', "Claude edits files and runs commands without ever asking. Use with care.")
+			}
+		];
+		for (const mode of modes) {
+			if (mode.mode === current) {
+				mode.description = localize('academicStudioClaudePermCurrent', "current setting");
+			}
+		}
+
+		const picked = await services.quickInputService.pick(modes, {
+			title: localize('academicStudioClaudePermissionsTitle', "Claude Permissions"),
+			placeHolder: localize('academicStudioClaudePermissionsPlaceholder', "How much can Claude do without asking you first? Your choice takes effect when a new chat is opened.")
+		});
+		if (!picked || picked.mode === current) {
+			return;
+		}
+
+		if (picked.mode === 'bypassPermissions') {
+			const { confirmed } = await services.dialogService.confirm({
+				type: 'warning',
+				message: localize('academicStudioClaudePermConfirm', "Allow Claude to do everything without asking?"),
+				detail: localize('academicStudioClaudePermConfirmDetail', "With \"Allow everything\", Claude will edit files and run commands without ever asking you. A mistaken command could delete or overwrite your work."),
+				primaryButton: localize('academicStudioClaudePermConfirmButton', "Allow Everything")
+			});
+			if (!confirmed) {
+				return;
+			}
+			await configurationService.updateValue(`${section}.allowDangerouslySkipPermissions`, true, ConfigurationTarget.USER);
+		} else {
+			// Close the dangerous gate again when moving off "Allow everything".
+			await configurationService.updateValue(`${section}.allowDangerouslySkipPermissions`, undefined, ConfigurationTarget.USER);
+		}
+
+		await configurationService.updateValue(`${section}.initialPermissionMode`, picked.mode, ConfigurationTarget.USER);
+		services.notificationService.info(localize('academicStudioClaudePermDone', "Claude permissions set to \"{0}\". This applies to new Claude conversations; a conversation that is already open keeps its current setting.", picked.label));
+	}
+}
+
+//#endregion
+
+//#region Skills
+
+// Skills are folders with a SKILL.md whose frontmatter carries a name and a
+// description. Global skills live in ~/<homeDir>/<skillsDir> (every project);
+// local skills in <workspace>/<projectDir>/<skillsDir> (this folder only). For
+// Claude both are .claude/skills.
+interface ISkillItem extends IQuickPickItem {
+	skillName: string;
+	skillRoot: URI;
+}
+
+async function listSkillsIn(services: IClaudeServices, dir: URI): Promise<ISkillItem[]> {
+	const fileService = services.fileService;
+	let names: string[] = [];
+	try {
+		const stat = await fileService.resolve(dir);
+		names = (stat.children ?? []).filter(child => child.isDirectory).map(child => child.name).sort();
+	} catch (e) {
+		return []; // no skills dir
+	}
+
+	const items: ISkillItem[] = [];
+	for (const name of names) {
+		const skillFile = joinPath(dir, name, 'SKILL.md');
+		const text = await readText(services, skillFile);
+		if (text === undefined) {
+			continue; // a folder without SKILL.md is not a skill
+		}
+		const match = text.match(/^description:\s*["']?(.+?)["']?\s*$/m);
+		const description = match ? match[1] : '';
+		items.push({
+			label: name,
+			detail: description.length > 140 ? description.slice(0, 140) + '…' : description,
+			skillName: name,
+			skillRoot: dir
+		});
+	}
+	return items;
+}
+
+function localSkillsDir(services: IClaudeServices): URI | undefined {
+	const folder = firstFolder(services);
+	return folder ? joinPath(folder.uri, services.agent.projectDir, services.agent.skillsDir) : undefined;
+}
+
+interface ISkillScopeItem extends IQuickPickItem {
+	root: URI;
+}
+
+class ClaudeNewSkillAction extends Action2 {
+	constructor() {
+		super({
