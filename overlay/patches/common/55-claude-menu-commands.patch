+//#region Memory files
+
+// The agent reads its instructions file (CLAUDE.md for Claude) from the project
+// root and from its home folder. Claude does NOT read AGENTS.md directly -- the
+// documented pattern is a CLAUDE.md line "@AGENTS.md" that imports it, wired up
+// automatically when creating AGENTS.md. That needs the agent's importSyntax,
+// and is pointless for an agent whose instructions file already is AGENTS.md.
+interface IMemoryFileItem extends IQuickPickItem {
+	kind: 'project' | 'global' | 'agents';
+}
+
+class ClaudeMemoryFilesAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudeMemoryFiles',
+			title: localize2('academicStudioClaudeMemoryFiles', "CLAUDE.md…"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		if (!services) {
+			return;
+		}
+		const agent = services.agent;
+		const who = agent.displayName;
+		const file = agent.instructionsFile;
+		const offerAgentsMd = !!agent.importSyntax && file !== 'AGENTS.md';
+		const folder = firstFolder(services);
+		const items: IMemoryFileItem[] = [];
+		if (folder) {
+			items.push({
+				label: localize('academicStudioClaudeMemProject', "{0} — this folder", file),
+				detail: localize('academicStudioClaudeMemProjectDetail', "Project instructions {0} reads whenever it works in \"{1}\".", who, folder.name),
+				kind: 'project'
+			});
+		}
+		items.push({
+			label: localize('academicStudioClaudeMemGlobal', "{0} — global", file),
+			detail: localize('academicStudioClaudeMemGlobalDetail', "Personal instructions {0} reads in every project ({1}).", who, homeLabel(services, file)),
+			kind: 'global'
+		});
+		if (folder && offerAgentsMd) {
+			items.push({
+				label: localize('academicStudioClaudeMemAgents', "AGENTS.md — this folder"),
+				detail: localize('academicStudioClaudeMemAgentsDetail', "Cross-tool instructions. {0} gets an \"{1}\" line so {2} reads it too.", file, agent.importSyntax!.replace('{0}', 'AGENTS.md'), who),
+				kind: 'agents'
+			});
+		}
+
+		const picked = await services.quickInputService.pick(items, {
+			title: localize('academicStudioClaudeMemTitle', "{0} Memory Files", who),
+			placeHolder: localize('academicStudioClaudeMemPlaceholder', "Instruction files {0} reads at the start of every conversation — pick one to create or edit", who)
+		});
+		if (!picked) {
+			return;
+		}
+
+		if (picked.kind === 'global') {
+			await ensureAndOpen(services, joinPath(await claudeHome(services), file), [
+				`# My Instructions for ${who} (all projects)`,
+				'',
+				`${who} reads this file at the start of every conversation, in every folder.`,
+				'Write personal preferences here — for example:',
+				'',
+				'- Explain what you are doing in plain language.',
+				'- I use Python; prefer pandas for data work.',
+				''
+			].join('\n'));
+			return;
+		}
+
+		if (!folder) {
+			return;
+		}
+
+		if (picked.kind === 'project') {
+			await ensureAndOpen(services, joinPath(folder.uri, file), [
+				`# Instructions for ${who} (this folder)`,
+				'',
+				`${who} reads this file at the start of every conversation in this folder.`,
+				'Write facts and rules about this project — for example:',
+				'',
+				'- The data files live in data/ and results go in output/.',
+				'- Always show plots with labeled axes.',
+				''
+			].join('\n'));
+			return;
+		}
+
+		// The agent only reads AGENTS.md through an import in its own instructions
+		// file -- make sure the import exists before opening AGENTS.md itself.
+		const importLine = agent.importSyntax!.replace('{0}', 'AGENTS.md');
+		const instructions = joinPath(folder.uri, file);
+		const existing = await readText(services, instructions) ?? '';
+		if (!existing.split('\n').some(line => line.replace(/\s+$/, '') === importLine)) {
+			try {
+				await services.fileService.writeFile(instructions, VSBuffer.fromString(importLine + '\n' + (existing ? '\n' + existing : '')));
+			} catch (e) {
