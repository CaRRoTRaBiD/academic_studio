+			}
+		}
+		await ensureAndOpen(services, joinPath(folder.uri, 'AGENTS.md'), [
+			'# Instructions for AI agents',
+			'',
+			'Instructions any AI coding tool should follow when working in this folder.',
+			''
+		].join('\n'));
